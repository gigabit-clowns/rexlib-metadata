{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Madrid",
  "addLabels": [
    "dependencies"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "poetry": {
    "description": "Off: the pep621 manager reads pyproject.toml.",
    "enabled": false
  },
  "packageRules": [
    {
      "description": "The organisation's own composites and reusable workflows stay on main, unpinned.",
      "matchDepNames": ["gigabit-clowns/.github"],
      "enabled": false
    },
    {
      "description": "A release past a range's ceiling widens the range to it.",
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "The CI matrix's Python versions are raised by hand.",
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "The polars pin for python_version == '3.10'.",
      "matchDepNames": ["polars"],
      "matchCurrentVersion": ">=2.0.0,<2.1.0",
      "constraints": { "python": "3.10" },
      "constraintsFiltering": "strict"
    },
    {
      "description": "The pyarrow pin for python_version == '3.10'.",
      "matchDepNames": ["pyarrow"],
      "matchCurrentVersion": "<26",
      "constraints": { "python": "3.10" },
      "constraintsFiltering": "strict"
    },
    {
      "description": "The numpy test pin for python_version == '3.10'.",
      "matchDepNames": ["numpy"],
      "matchCurrentVersion": "<2.3",
      "constraints": { "python": "3.10" },
      "constraintsFiltering": "strict"
    },
    {
      "description": "The numpy test pin for python_version == '3.11'.",
      "matchDepNames": ["numpy"],
      "matchCurrentVersion": ">=2.3,<2.5",
      "constraints": { "python": "3.11" },
      "constraintsFiltering": "strict"
    },
    {
      "description": "The pandas test pin for python_version == '3.10'.",
      "matchDepNames": ["pandas"],
      "matchCurrentVersion": "<3",
      "constraints": { "python": "3.10" },
      "constraintsFiltering": "strict"
    },
    {
      "description": "The python_version == '3.10' half of the pandas extra, told apart by its raw value.",
      "matchDepNames": ["pandas"],
      "matchDepTypes": ["project.optional-dependencies"],
      "matchCurrentValue": "/<=2\\./",
      "allowedVersions": "<3"
    },
    {
      "description": "arrow, pyo3 and pyo3-arrow in one pull request, majors included.",
      "matchDepNames": ["arrow", "pyo3", "pyo3-arrow"],
      "groupName": "arrow, pyo3 and pyo3-arrow",
      "separateMajorMinor": false
    }
  ]
}
